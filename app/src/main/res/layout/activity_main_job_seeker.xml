<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- العمر -->
        <Spinner
            android:id="@+id/spinner_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- المنطقة -->
        <Spinner
            android:id="@+id/spinner_region"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- البلد (يتغير حسب المنطقة) -->
        <Spinner
            android:id="@+id/spinner_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- نوع العمل (مؤقت - دائم...) -->
        <Spinner
            android:id="@+id/spinner_job_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- العمل بشكل عام (مجال العمل) -->
        <Spinner
            android:id="@+id/spinner_job_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- الوظائف التي تظهر حسب المجال -->
        <Spinner
            android:id="@+id/spinner_specific_job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- أجر الساعة -->
        <Spinner
            android:id="@+id/spinner_hourly_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/button_search"
            android:text="חפש"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>